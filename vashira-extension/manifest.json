{
  "manifest_version": 3,
  "name": "Vashira Snatcher-X",
  "version": "1.0",
  "description": "Master the web. Capture research directly into your Sovereign Vashira Hub.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://*/"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
