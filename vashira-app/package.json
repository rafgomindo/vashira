{
  "name": "vashira",
  "productName": "Vashira",
  "version": "10.1.0",
  "description": "European Open-Source Research Program - Master your Research",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "npm run build && electron-forge start",
    "build:main": "esbuild src/main.ts --bundle --platform=node --target=node18 --outfile=.vite/build/main.js --external:electron --external:better-sqlite3",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --target=node18 --outfile=.vite/build/preload.js --external:electron",
    "build:renderer": "node build-renderer.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [],
  "author": "Rafael Domingo Ramones (raf_gomindo) <https://ram0nes.com/>",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.1",
    "citeproc": "^2.4.63",
    "electron": "^32.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~4.5.4",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.8.0",
    "d3-force": "^3.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.12.0",
    "nat-upnp": "^1.1.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "tesseract.js": "^7.0.0"
  }
}
